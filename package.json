{
  "name": "coastal-city-viz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive dashboard for comparing Southeast Asian coastal cities by domestic tourism, nightlife density, walkability, population, and living costs.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data:validate": "node scripts/validate-data.mjs",
    "vacation:generate": "python scripts/generate-vacation-data.py",
    "vacation:validate": "node scripts/validate-vacation-data.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
